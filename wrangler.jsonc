{
  "name": "skyfall",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-17",
  "upload_source_maps": true,
  "workers_dev": true,
  "routes": [
    { "pattern": "skyfall.akimus.ru", "custom_domain": true }
  ],
  "vars": {
    "TURN_URLS": "turn:62.84.172.208:3478?transport=udp,turn:62.84.172.208:3478?transport=tcp"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  "observability": {
    "enabled": true
  }
}
